<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مظهر الكرة"
            android:textAppearance="?attr/textAppearanceHeadline5" />

        <FrameLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:background="#33888888" />

        <TextView
            android:id="@+id/sizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/sizeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeO"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="o" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeS"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="صغير" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeM"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="متوسط" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizeL"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="كبير" />
        </LinearLayout>

        <TextView
            android:id="@+id/opLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/opSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اللون"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCustomColor"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لون مخصص (#RRGGBB)" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إظهار أيقونة القلم" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="إطار أبيض حول الكرة" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="مربع بزوايا مدورة بدل الدائرة" />

        <TextView
            android:id="@+id/mediaLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="يمكنك استخدام صورة أو GIF أو فيديو MP4 (حتى 30MB) كخلفية للكرة. الفيديو صامت ويتكرر، وقد يستهلك بطارية أكثر."
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickMedia"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="اختيار صورة / GIF / فيديو" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveMedia"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إزالة الصورة / الفيديو" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetPos"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="إعادة موضع الكرة الحرة" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استعادة المظهر الافتراضي" />
    </LinearLayout>
</ScrollView>
