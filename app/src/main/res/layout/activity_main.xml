<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadline5" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/open_settings" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/switch_enabled" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSkipNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/switch_skip_numbers" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchImeOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="إظهار الزر فقط عند ظهور لوحة المفاتيح (وضع «بجانب الحقل»)" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="الزر على اليسار بدل اليمين (بجانب الحقل / فوق لوحة المفاتيح)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="طريقة الاستدعاء"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeNear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="زر بجانب الحقل (الافتراضي)" />

            <RadioButton
                android:id="@+id/modeKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="زر ثابت فوق لوحة المفاتيح" />

            <RadioButton
                android:id="@+id/modeFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="كرة عائمة قابلة للسحب (ظاهرة دائماً)" />

            <RadioButton
                android:id="@+id/modeHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بدون زر: أستدعيه يدوياً" />

            <RadioButton
                android:id="@+id/modeTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بدون زر: يفتح فوراً عند الضغط على الحقل" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="الاستدعاء اليدوي: من زر «المحرر الكبير» في مربع الإشعارات السريعة (أضفه من تعديل الأزرار)، أو من أيقونة «فتح المحرر» في قائمة التطبيقات، أو من زر إمكانية الوصول. يفتح المحرر للحقل المحدد، أو للحقل الوحيد الظاهر، وإن وُجد أكثر من حقل ولم تحدد أحدها فاضغط على الحقل المطلوب ليفتح فوراً."
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="تخصيص مظهر الكرة" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExcluded"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="التطبيقات المستثناة" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearDrafts"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مسح المسودات المحفوظة" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/how_to_title"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/how_to_body"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/try_title"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tryField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/try_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
