<?xml version="1.0" encoding="utf-8"?>
<com.bigtype.app.PanelRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:layout_margin="8dp"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- الشريط العلوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="المحرر الكبير"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="تراجع"
                android:src="@drawable/ic_undo" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="إعادة"
                android:src="@drawable/ic_redo" />

            <ImageButton
                android:id="@+id/btnFind"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="بحث واستبدال"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="المزيد"
                android:src="@drawable/ic_more" />

            <ImageButton
                android:id="@+id/btnExpand"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="تكبير أو تصغير"
                android:src="@drawable/ic_expand" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="38dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="إغلاق"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- البحث والاستبدال -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/findInput"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:hint="بحث"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/matchInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:gravity="center"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="السابق"
                    android:src="@drawable/ic_up" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="36dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="التالي"
                    android:src="@drawable/ic_down" />
            </LinearLayout>

            <EditText
                android:id="@+id/replaceInput"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="استبدال بـ  ($1 للمجموعات)"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRegex"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Regex" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCase"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aa" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWord"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="كلمة كاملة" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplace"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="استبدال" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReplaceAll"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="استبدال الكل" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/searchError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- منطقة الكتابة -->
        <EditText
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:padding="14dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="12sp" />

        <!-- أزرار النقل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendEnter"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:text="نقل + Enter"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="نقل النص إلى الحقل"
                android:textSize="16sp"
                app:cornerRadius="14dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </LinearLayout>
</com.bigtype.app.PanelRoot>
